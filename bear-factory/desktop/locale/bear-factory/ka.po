# Class description
# ../../../item-description/generic/hidden_block.xml
msgid "A block that changes its opacity when an oject collides."
msgstr "ბლოკი, რომელიც იცვლის გაუმჭვირვალობას, როცა ობიექტი ეჯახება."

# Class description
# ../../../item-description/generic/level_variable/bool_level_variable_getter_creator.xml
msgid "A boolean expression that returns the value of a level variable"
msgstr "ლოგიკური გამოსახულება, რომელიც დონის ცვლადის მნიშვნელობას აბრუნებს"

# Class description
# ../../../item-description/generic/expr/any_input_pressed.xml
msgid "A boolean expression that returns true if any input is pressed."
msgstr ""
"ლოგიკური გამოსახულება, რომელიც ჭეშმარიტს აბრუნებს, თუ რამე ღილაკს დააჭერთ."

# Class description
# ../../../item-description/generic/camera_on_object.xml
msgid "A camera shared among some objects."
msgstr "კამერა გაზიარებულია რამდენიმე ობიექტს შორის."

# Class description
# ../../../item-description/generic/descending_ceiling.xml
msgid "A ceiling that is not horizontal."
msgstr "სახურავი, რომელიც ჰორიზონტალური არაა."

# Class description
# ../../../item-description/generic/item_brick/forced_movement_creator_with_reference.xml
msgid "A class for forced movement with item reference."
msgstr "კლასი ელემენტის მიმართვის შემცველი ნაძალადევი გადაადგილებებისთვის."

# Class description
# ../../../item-description/generic/block.xml
msgid "A classic block, to be used for walls, grounds, ceilings or anything."
msgstr ""
"კლასიკური ბლოკი, რომელიც შეგიძლიათ გამოიყენოთ კედლებისთვის, საძირკვლისთვის, "
"ჭერისთვის და ა.შ."

# Class description
# ../../../item-description/generic/link/chain_link_visual.xml
msgid ""
"A decorative chain linking two items. The chain falls when the items are far "
"from each other horizontally but stay straight when they are aligned "
"vertically."
msgstr ""
"ორი ელემენტის შემაერთებელი დეკორატიული ჯაჭვი. ჯაჭვი გაწყდება, როცა "
"ელემენტები ერთმანეთისგან შორიშორს არიან ჰორიზონტალურად, მაგრამ დარჩება "
"შეერთებულად, თუ მათ ვერტიკალურად ასწორებთ."

# Class description
# ../../../item-description/generic/decorative_model.xml
msgid "A decorative model."
msgstr "დეკორატიული მოდელი."

# Class description
# ../../../item-description/generic/slope.xml
msgid "A ground that is not horizontal."
msgstr "იატაკი, რომელიც ჰორიზონტალური არაა."

# Class description
# ../../../item-description/generic/expr/timer_value.xml
msgid "A linear expression that returns the value of a timer."
msgstr "წრფივი გამოსახულება, რომელიც ტაიმერის მნიშვნელობას აბრუნებს."

# Class description
# ../../../item-description/generic/linear_movement_sequence_loop.xml
msgid ""
"A linear_movement_sequence_loop is an item that creates some items and sets "
"their movement as a linear movement."
msgstr ""
"linear_movement_sequence_loop ელემენტია, რომელიც ქმნის რამდენიმე ელემენტს და "
"აყენებს მათ გადაადგილებას წრფივ გადაადგილებაზე."

# Field description
