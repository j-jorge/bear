msgstr "'\n"

#: ../../../core/src/engine/code/game_local_client.cpp:1420
msgid "--game-var-assignment: not a character."
msgstr "--game-var-assignment: სიმბოლო არაა."

#: ../../../core/src/engine/code/game_local_client.cpp:1436
msgid "--set-game-var-bool: not a boolean"
msgstr "--set-game-var-bool: ლოგიკური მნიშვნელობა არაა"

#: ../../../core/src/engine/code/game_local_client.cpp:1426
msgid "--set-game-var-int: not an integer"
msgstr "--set-game-var-int: მთელი რიცხვი არაა"

#: ../../../core/src/engine/code/game_local_client.cpp:1441
msgid "--set-game-var-real: not a real number"
msgstr "--set-game-var-real: რეალური რიცხვი არაა"

#: ../../../core/src/engine/code/game_local_client.cpp:1431
msgid "--set-game-var-uint: not an unsigned integer"
msgstr "--set-game-var-uint: უნიშნო მთელი რიცხვი არაა"

#: ../../../core/src/engine/code/game_local_client.cpp:1587
msgid "Associates an identifier with this game."
msgstr "იდენტიფიკატორის ასოცირება ამ თამაშთან."

#: ../../../core/src/engine/code/game_local_client.cpp:1459
msgid "Bad argument value: '"
msgstr "არასწორი არგუმენტის მნიშვნელობა: '"

#: ../../../core/src/engine/code/game_local_client.cpp:1575
msgid ""
"Changes the delimiter used in --set-game-var-<type> to separate the name and "
"the value of the variable."
msgstr ""
"ცვლის პარამეტრში --set-game-var-<ტიპი>-ში გამოყენებულ ცვლადის სახელისა და "
"მნიშვნელობის გამყოფს."

#: ../../../core/src/engine/code/game_local_client.cpp:1537
msgid "Engine's options:"
msgstr "ძრავის პარამეტრები:"

#: ../../../core/src/engine/code/game_description.cpp:125
msgid "Path to a library containing items for the game."
msgstr "ბილიკი ბიბლიოთეკამდე, რომელიც თამაშის ელემენტებს შეიცავს."

#: ../../../core/src/engine/code/game_description.cpp:115
msgid "Path to the directory containing the data of the game."
msgstr "ბილიკი საქაღალდემდე, რომელიც თამაშის მონაცემებს შეიცავს."

#: ../../../running_bear/code/running_bear.cpp:38
msgid "Print this help screen and exit."
msgstr "ამ დახმარების ეკრანის გამოტანა და გასვლა."

#: ../../../core/src/engine/code/game_local_client.cpp:1602
msgid "Prints the version of the engine and exit."
msgstr "ძრავის ვერსიის გამოტანა და გასვლა."

#: ../../../core/src/engine/code/game_local_client.cpp:1543
msgid "Run the game in a window."
msgstr "თამაშის ფანჯარაში გაშვება."

#: ../../../core/src/engine/code/game_local_client.cpp:1542
msgid "Runs the game in fullscreen mode."
msgstr "გაუშვებს თამაშს სრულეკრანიან რეჟიმში."

#: ../../../core/src/engine/code/game_local_client.cpp:1546
msgid "Search the items in the game launcher."
msgstr "ელემენტების ძებნა თამაშის გამშვებში."

#: ../../../core/src/engine/code/game_local_client.cpp:1592
msgid "Sets the limit of the number of frames per second."
msgstr "დააყენებს წამში კადრების რაოდენობის ლიმიტს."

#: ../../../core/src/engine/code/game_local_client.cpp:1562
msgid "Sets the value of a boolean game variable."
msgstr "დააყენებს თამაშის ლოგიკური ტიპის ცვლადის მნიშვნელობას."

#: ../../../core/src/engine/code/game_local_client.cpp:1558
msgid "Sets the value of a non negative integer game variable."
msgstr ""
"დააყენებს თამაშის არაუარყოფითი მთელი რიცხვის ტიპის ცვლადის მნიშვნელობას."

#: ../../../core/src/engine/code/game_local_client.cpp:1566
msgid "Sets the value of a real number game variable."
msgstr "დააყენებს თამაშის რეალური რიცხვის ტიპის ცვლადის მნიშვნელობას."

#: ../../../core/src/engine/code/game_local_client.cpp:1570
msgid "Sets the value of a string game variable."
msgstr "დააყენებს თამაშის სტრიქონის ტიპის ცვლადის მნიშვნელობას."

#: ../../../core/src/engine/code/game_local_client.cpp:1554
msgid "Sets the value of an integer game variable."
msgstr "დააყენებს თამაშის მთელი რიცხვის ტიპის ცვლადის მნიშვნელობას."

#: ../../../core/src/engine/code/game_local_client.cpp:1582
msgid "Sets the value of the destination to which game statistics are sent."
msgstr "დააყენებს თამაშის სტატისტიკის გაგზავნის სამიზნის მნიშვნელობას."

#: ../../../core/src/engine/code/game_description.cpp:122
msgid "Tells not to use the dumbest rendering procedure."
msgstr "ეუბნება, რომ არ გამოიყენოს ყველაზე სულელი რენდერის პროცედურა."

#: ../../../core/src/engine/code/game_local_client.cpp:1598
msgid "Tells to do a rendering of the scene for each progress of the game."
msgstr "ეუბნება, რომ გააკეთოს თამაშის მიმდინარეობის თითოეული სცენის რენდერი."

#: ../../../core/src/engine/code/game_description.cpp:119
msgid "Tells to use the dumbest rendering procedure."
msgstr "ეუბნება, რომ გამოიყენოს ყველაზე სულელური რენდერის პროცედურა."

#: ../../../core/src/engine/code/game_local_client.cpp:1549
msgid ""
"The delay to apply to the network messages in term of game iterations. "
"Default is 1."
msgstr ""
"დაყოვნება, რომელიც გამოიყენება ქსელური შეტყობინებებისთვის თამაშის "
"გამეორებისას. ნაგულისხმევია 1."

#: ../../../core/src/engine/code/game_description.cpp:111
